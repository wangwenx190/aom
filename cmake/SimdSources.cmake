# Source lists and instruction-set flags from upstream's codec targets.
macro(aom_intrinsics flag)
    set_source_files_properties(${ARGN} PROPERTIES COMPILE_OPTIONS "${flag}")
    list(APPEND codec_sources ${ARGN})
endmacro()

